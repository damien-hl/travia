{
  "name": "travia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p typecheck \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@fontsource/buenard": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "aos": "^2.3.4",
    "normalize.css": "^8.0.1",
    "sass-embedded": "^1.104.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/aos": "^3.0.8",
    "@types/node": "^24.13.6",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged",
    "pre-push": "pnpm typecheck"
  },
  "nano-staged": {
    "*.{js,ts}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,css,scss,md,yaml,yml}": [
      "oxfmt --write"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@12.5.1"
}
